<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaTodoApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1260" d:DesignHeight="840"
        x:Class="AvaloniaTodoApp.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SEMI-INSPECT 3D PRO - 芯片检测全业务与上位机平台"
        Icon="avares://AvaloniaTodoApp/Assets/app-icon.png"
        Width="1280" Height="840"
        MinWidth="1000" MinHeight="680"
        Background="#0b1120"
        WindowStartupLocation="CenterScreen">

    <!-- 全局精美组件样式与微动效过渡 -->
    <Window.Styles>
        <!-- 侧边栏导航项基础样式：始终预设 3px 左边框与透明画刷，彻底杜绝激活时的布局抖动 (0 像素位移) -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="11,10,12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 覆盖 FluentTheme 默认模板零件 ContentPresenter，彻底消除鼠标点击时的原生半透明白闪 (White Flash) -->
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#152138" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="Button.nav-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0e1829" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- 激活项样式：点亮左侧 3px 科技天蓝光条与高亮底色，尺寸无任何跳动 -->
        <Style Selector="Button.nav-item.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#132b45" />
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="Button.nav-item.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#173454" />
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="Button.nav-item.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0f2238" />
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- 关于按钮静默样式 -->
        <Style Selector="Button.about-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#152138" />
        </Style>
        <Style Selector="Button.about-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0e1829" />
        </Style>
    </Window.Styles>

    <!-- 主窗口两栏布局：左侧精美侧边栏 (224px) + 右侧基于 ViewLocator 的路由出口 (*) -->
    <Grid ColumnDefinitions="224, *">

        <!-- ============================================================================== -->
        <!-- 左侧工业级深色侧边栏导航 (Sidebar)                                                -->
        <!-- ============================================================================== -->
        <Border Grid.Column="0"
                Background="#080c16"
                BorderBrush="#1e293b"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto" Margin="14,18">

                <!-- 1. 顶部 Brand 品牌徽章与标题 -->
                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="10"
                                Background="#0f2642"
                                BorderBrush="#0284c7"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconChip3D}" Width="20" Height="20"
                                      Foreground="#38bdf8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SEMI-INSPECT" FontSize="13" FontWeight="Heavy"
                                       Foreground="#f8fafc" LetterSpacing="0.8" />
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <Border Background="#0f2942" CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#38bdf8" />
                                </Border>
                                <TextBlock Text="上位机 3D 平台" FontSize="10" Foreground="#94a3b8" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Separator Background="#1e293b" Height="1" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 2. 中部核心业务导航菜单 (触发路由切换指令) -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="业务与监测模块" FontSize="10" FontWeight="SemiBold"
                               Foreground="#64748b" Margin="4,0,0,6" LetterSpacing="0.5" />

                    <!-- 模块 1: 3D 芯片全业务看板 -->
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsModuleChipInspect}"
                            Command="{Binding SwitchModuleCommand}"
                            CommandParameter="ChipInspect">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconChip3D}" Width="16" Height="16"
                                      Foreground="#38bdf8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="3D 芯片检测" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#f1f5f9" />
                                <TextBlock Text="Three.js 12大场景" FontSize="10" Foreground="#64748b" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 模块 2: 生产工单与任务待办 -->
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsModuleTodo}"
                            Command="{Binding SwitchModuleCommand}"
                            CommandParameter="Todo">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconListTodo}" Width="16" Height="16"
                                      Foreground="#38bdf8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="待办任务工单" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#f1f5f9" />
                                <TextBlock Text="{Binding TodoVm.StatusSummary}" FontSize="10" Foreground="#64748b" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 模块 3: 工业设备与运行日志 -->
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsModuleLogs}"
                            Command="{Binding SwitchModuleCommand}"
                            CommandParameter="Logs">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconTerminal}" Width="16" Height="16"
                                      Foreground="#a78bfa" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="工业运行日志" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#f1f5f9" />
                                <TextBlock Text="Serilog 滚动归档" FontSize="10" Foreground="#64748b" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 3. 底部硬件遥测、关于与版本状态 -->
                <StackPanel Grid.Row="2" Spacing="10">
                    <Separator Background="#1e293b" Height="1" />

                    <!-- PLC 在线通讯状态卡片 -->
                    <Border Background="#0d1424" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Ellipse Width="8" Height="8" Fill="#10b981" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="PLC 上位机通信" FontSize="11" Foreground="#cbd5e1"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#064e3b" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="在线" FontSize="9" FontWeight="Bold" Foreground="#34d399" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 关于与版本更新按钮 -->
                    <Button Classes="about-btn"
                            Command="{Binding OpenAboutCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" Width="13" Height="13"
                                      Foreground="#38bdf8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="关于与检查更新" FontSize="11" Foreground="#94a3b8"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AppVersion}" FontSize="10"
                                       Foreground="#38bdf8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================================== -->
        <!-- 右侧主工作区：基于 ViewLocator + ContentControl 的多通道保活路由出口                   -->
        <!-- 保持原生 WebKit / WebGL 句柄常驻视觉树，杜绝 Detach 销毁导致的 3D 画布黑屏问题           -->
        <!-- ============================================================================== -->
        <Grid Grid.Column="1" Background="#070a12">
            <!-- 模块 1: 3D 芯片检测与上位机看板 (常驻原生通道，WebGL 零销毁、零重载、永不黑屏) -->
            <ContentControl Content="{Binding ChipInspectVm}"
                            IsVisible="{Binding IsModuleChipInspect}" />

            <!-- 模块 2: 生产工单与待办任务 -->
            <ContentControl Content="{Binding TodoVm}"
                            IsVisible="{Binding IsModuleTodo}" />

            <!-- 模块 3: 工业设备与运行日志 -->
            <ContentControl Content="{Binding DeviceLogsVm}"
                            IsVisible="{Binding IsModuleLogs}" />
        </Grid>

    </Grid>
</Window>
