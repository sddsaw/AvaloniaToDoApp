<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaTodoApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="700"
        x:Class="AvaloniaTodoApp.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Avalonia TodoList"
        Icon="avares://AvaloniaTodoApp/Assets/app-icon.png"
        Width="540" Height="700"
        MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <!-- 
        【前端对比】Window.Styles 相当于当前组件的局部 <style scoped>
        Avalonia 支持类选择器 (如 Button.filter-btn)、伪类选择器 (如 :pointerover, :pressed)
    -->
    <Window.Styles>
        <!-- 基础卡片样式 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000" />
        </Style>

        <!-- 任务卡片样式与悬浮过渡 -->
        <Style Selector="Border.task-item">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.task-item:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.task-item.completed">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- 任务文本完成时的删除线与透明度 (类似 CSS: text-decoration: line-through) -->
        <Style Selector="TextBlock.task-text.strike">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <!-- 筛选 Tab 按钮样式 -->
        <Style Selector="Button.filter-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.filter-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.filter-btn.active">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 垃圾桶删除按钮样式 -->
        <Style Selector="Button.del-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.del-btn:pointerover">
            <Setter Property="Background" Value="#22FF0000" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </Window.Styles>

    <!-- 主容器背景 -->
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="24">

        <!-- 1. 顶部 Header 区域 (标题与状态汇总) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <PathIcon Data="{StaticResource IconListTodo}" Width="24" Height="24"
                          Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                <TextBlock Text="今日待办" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 状态统计徽章与关于更新按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="14"
                        Padding="12,5">
                    <TextBlock Text="{Binding StatusSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>

                <Button Command="{Binding OpenAboutCommand}"
                        ToolTip.Tip="关于应用与检查更新"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="0"
                        Padding="10,5"
                        CornerRadius="14"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconInfo}" Width="12" Height="12"
                                  Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersion}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 输入框区域 (包含 Enter 键绑定与添加按钮) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <TextBox Grid.Column="0"
                     Watermark="输入待办事项，按回车或右侧按钮添加..."
                     Text="{Binding NewTaskTitle, Mode=TwoWay}"
                     IsEnabled="{Binding !IsLoading}"
                     FontSize="14"
                     CornerRadius="8"
                     Padding="12,10"
                     VerticalContentAlignment="Center">
                <!-- 键盘快捷键监听 (类似前端 @keydown.enter="addTask") -->
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{Binding AddTaskCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Margin="10,0,0,0"
                    Padding="16,10"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    Background="{DynamicResource SystemAccentColor}"
                    Foreground="White"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="添加" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. 筛选器工具栏 (Tab 筛选 + 一键清空已完成) -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,14">
            <!-- 筛选 Tab 按钮组 (使用 Avalonia 的动态类绑定 Classes.active="{Binding IsFilterAll}") -->
            <!-- 这与前端 Vue 中的 :class="{ active: isFilterAll }" 完全相同 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="8"
                    Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="filter-btn"
                            Classes.active="{Binding IsFilterAll}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="All"
                            Content="全部" />
                    <Button Classes="filter-btn"
                            Classes.active="{Binding IsFilterActive}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Active"
                            Content="进行中" />
                    <Button Classes="filter-btn"
                            Classes.active="{Binding IsFilterCompleted}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Completed"
                            Content="已完成" />
                </StackPanel>
            </Border>

            <!-- 清除已完成按钮 -->
            <Button Grid.Column="2"
                    Content="清除已完成"
                    Command="{Binding ClearCompletedCommand}"
                    IsVisible="{Binding HasCompletedItems}"
                    Background="Transparent"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    FontSize="12"
                    Cursor="Hand"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- 4. 任务列表与空状态呈现区 -->
        <Grid Grid.Row="3">
            <!-- 列表视图 (类似前端 v-for / list.map) -->
            <ScrollViewer IsVisible="{Binding !IsDisplayEmpty}">
                <ItemsControl ItemsSource="{Binding DisplayTasks}">
                    <ItemsControl.ItemTemplate>
                        <!-- 单个 TodoItem 的模板渲染 (类型为 TodoItemViewModel) -->
                        <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <Border Classes="task-item"
                                    Classes.completed="{Binding IsCompleted}">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                    <!-- 复选框 (双向绑定 IsCompleted，类似 v-model="item.isCompleted") -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                                    <!-- 任务内容 (根据状态动态绑定 strike 类) -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Classes="task-text"
                                               Classes.strike="{Binding IsCompleted}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                    <!-- 创建时间 -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CreatedAtText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />

                                    <!-- 
                                        删除按钮 
                                        【前端对比】在子项中调用父级组件方法：
                                        这里通过 #RootWindow 寻址到主窗口的 DataContext (MainWindowViewModel) 并调用 RemoveTaskCommand
                                    -->
                                    <Button Grid.Column="3"
                                            Classes="del-btn"
                                            ToolTip.Tip="删除任务"
                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveTaskCommand}"
                                            CommandParameter="{Binding .}">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" Foreground="#FF6B6B" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态提示 (当没有任务时展示，类似前端 <div v-if="isEmpty">) -->
            <Border Classes="card"
                    IsVisible="{Binding IsDisplayEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="32"
                    Margin="20">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <PathIcon Data="{StaticResource IconCheckCircle}" Width="44" Height="44"
                              Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无符合条件的待办事项"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="享受你的空闲时光，或者在上方添加新任务吧！"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. 底部状态与提示栏 -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconSave}" Width="12" Height="12"
                          Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StorageStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="关闭窗口常驻后台托盘"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="Avalonia 11"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
