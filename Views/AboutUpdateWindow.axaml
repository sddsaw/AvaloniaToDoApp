<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaTodoApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="520"
        x:Class="AvaloniaTodoApp.Views.AboutUpdateWindow"
        x:DataType="vm:AboutUpdateViewModel"
        Title="关于与版本更新"
        Width="460" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://AvaloniaTodoApp/Assets/app-icon.png">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        <!-- 顶部信息 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,20">
            <Border Width="64" Height="64" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center">
                <Image Source="avares://AvaloniaTodoApp/Assets/app-icon.png" Width="64" Height="64" />
            </Border>
            <TextBlock Text="Avalonia Todo App" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding CurrentVersion}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemAccentColor}" />
                </Border>
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="4" Padding="6,2">
                    <TextBlock Text=".NET 8 + Avalonia 11" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 中部状态与更新日志卡片 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <!-- 本地数据存储路径说明卡片 -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14"
                                      Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="本地数据存储" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StoragePath}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Text="任务数据实时异步保存，关闭后随时重启恢复。"
                                   FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    </StackPanel>
                </Border>

                <!-- 工业日志说明与快捷查看卡片 -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconTerminal}" Width="14" Height="14"
                                          Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                                <TextBlock Text="工业运行与故障日志" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    Cursor="Hand"
                                    Content="打开日志目录" />
                        </Grid>
                        <TextBlock Text="{Binding LogFolderPath}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Text="基于 Serilog 毫秒级按天滚动归档，全局防闪退异常自动落盘。"
                                   FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    </StackPanel>
                </Border>

                <!-- 版本状态卡片 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"
                                          Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                                <TextBlock Text="版本检测与升级" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding LatestVersion}" FontSize="12"
                                       Foreground="{DynamicResource SystemAccentColor}" FontWeight="Bold" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <!-- 更新日志展示区（当有新版本时展示） -->
                        <StackPanel IsVisible="{Binding HasUpdate}" Spacing="8">
                            <Separator />
                            <TextBlock Text="{Binding ReleaseTitle}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource SystemAccentColor}" />
                            <TextBlock Text="{Binding ReleaseNotes}" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作按钮 -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,16,0,0">
            <Button Command="{Binding CheckUpdateCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    Classes="accent"
                    Background="{DynamicResource SystemAccentColor}"
                    Foreground="White"
                    CornerRadius="6"
                    Padding="16,8"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CheckButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    IsVisible="{Binding HasUpdate}"
                    Command="{Binding OpenDownloadUrlCommand}"
                    CornerRadius="6"
                    Padding="16,8"
                    Background="#10B981"
                    Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="前往下载更新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
