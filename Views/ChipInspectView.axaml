<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:webview="using:AvaloniaWebView"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AvaloniaTodoApp.Views.ChipInspectView">

    <Grid RowDefinitions="Auto, *">
        <!-- 3D 看板顶部快捷遥测条（深色工业质感） -->
        <Border Grid.Row="0"
                Background="#0a0e1a"
                BorderBrush="#1e293b"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconChip3D}" Width="16" Height="16"
                              Foreground="#38bdf8" VerticalAlignment="Center" />
                    <TextBlock Text="半导体芯片全业务 3D 监控与上位机看板"
                               FontWeight="Bold" FontSize="13" Foreground="#f8fafc" VerticalAlignment="Center" />
                    <Border Background="#0f2942" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                        <TextBlock Text="Three.js WebGL 引擎" FontSize="10" Foreground="#38bdf8" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#10b981" VerticalAlignment="Center" />
                        <TextBlock Text="WebGL 硬件加速: 激活" FontSize="11" Foreground="#94a3b8" />
                    </StackPanel>
                    <Button Name="BtnReload"
                            Click="BtnReload_OnClick"
                            Padding="10,4"
                            FontSize="11"
                            CornerRadius="6"
                            Cursor="Hand"
                            Background="#1e293b"
                            Foreground="#f8fafc"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" Foreground="#38bdf8" VerticalAlignment="Center" />
                            <TextBlock Text="重载画布" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView 嵌入容器 -->
        <webview:WebView Grid.Row="1" x:Name="InspectWebView" />
    </Grid>
</UserControl>
