<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 清空其它源，确保在断网/内网环境下不会因尝试连接公网源而超时 -->
    <clear />
    <add key="local-packages" value="./local-packages" />
    <!-- 在外网开发机若需下载新的 NuGet 依赖，可临时取消下面一行的注释: -->
    <!-- <add key="nuget.org" value="https://api.nuget.org/v3/index.json" /> -->
  </packageSources>
</configuration>
